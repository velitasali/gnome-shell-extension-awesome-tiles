{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "outDir": "build",
    "rootDir": "src",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "gi://Meta": ["node_modules/@girs/meta-18/meta-18.d.ts"],
      "gi://Shell": ["node_modules/@girs/shell-18/shell-18.d.ts"],
      "gi://Gio": ["node_modules/@girs/gio-2.0/gio-2.0.d.ts"],
      "gi://Gio?version=2.0": ["node_modules/@girs/gio-2.0/gio-2.0.d.ts"],
      "gi://GLib": ["node_modules/@girs/glib-2.0/glib-2.0.d.ts"],
      "gi://GLib?version=2.0": ["node_modules/@girs/glib-2.0/glib-2.0.d.ts"],
      "gi://Clutter": ["node_modules/@girs/clutter-18/clutter-18.d.ts"],
      "gi://St": ["node_modules/@girs/st-18/st-18.d.ts"],
      "gi://Gtk": ["node_modules/@girs/gtk-4.0/gtk-4.0.d.ts"],
      "gi://Adw": ["node_modules/@girs/adw-1/adw-1.d.ts"],
      "gi://Gdk": ["node_modules/@girs/gdk-4.0/gdk-4.0.d.ts"],
      "gi://Mtk": ["node_modules/@girs/mtk-18/mtk-18.d.ts"],
    },
  },
  "include": ["src/**/*.ts"],
}
